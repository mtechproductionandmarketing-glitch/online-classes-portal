# Supabase Configuration
# Get these from your Supabase project settings: https://supabase.com/dashboard
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_anon_key_here
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here

# Rate Limiting Configuration (Optional)
RATE_LIMIT_ENABLED=true
RATE_LIMIT_SUBMISSIONS=20
RATE_LIMIT_WINDOW=600

# Feature Flags (Optional, for future versions)
ENABLE_EMAIL_NOTIFICATIONS=false

# Deployment Environment
NODE_ENV=production

# Application Settings
NEXT_PUBLIC_APP_URL=https://your-domain.vercel.app

# Do not add Supabase keys as NEXT_PUBLIC_ unless necessary
# Service role key must ONLY be in server-side environment variables
